
digraph safety_pipeline_abstract {
    graph [
        rankdir=LR
        fontname="Helvetica,sans-Serif"
        fontsize=12
        bgcolor="white"
        pad=0.35
        nodesep=0.45
        ranksep=0.5
        label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
            <TR><TD><B><FONT POINT-SIZE="14" COLOR="#1a1a1a">Safety Critic Pipeline</FONT></B></TD></TR>
            <TR><TD><FONT POINT-SIZE="9.5" COLOR="#888888">From rewriting-stage text to a response constraint</FONT></TD></TR>
        </TABLE>>
        labelloc=t
        labeljust=c
    ]
    node [fontname="Helvetica,sans-Serif" fontsize=10]
    edge [fontname="Helvetica,sans-Serif" fontsize=8.5]

    // ── Input ──
    input [
        shape=none margin=0
        label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"
               BGCOLOR="#E3F2FD" COLOR="#1565C0" STYLE="ROUNDED">
            <TR><TD ALIGN="CENTER"><B><FONT COLOR="#1565C0" POINT-SIZE="10">Inputs</FONT></B></TD></TR>
            <TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7.5" COLOR="#666666">User rewriting message</FONT></TD></TR>
            <TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7.5" COLOR="#666666">+ nightmare summary</FONT></TD></TR>
        </TABLE>>
    ]

    // ── Critic module ──
    critic [
        shape=none margin=0
        label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="4" CELLPADDING="8"
               BGCOLOR="#FFFFFF" COLOR="#455A64" STYLE="ROUNDED">
            <TR>
                <TD COLSPAN="3" BORDER="0" BGCOLOR="#ECEFF1" ALIGN="CENTER">
                    <B><FONT COLOR="#263238" POINT-SIZE="11">SafetyCritic</FONT></B>
                </TD>
            </TR>
            <TR>
                <TD BGCOLOR="#FFF3E0" COLOR="#E65100" ALIGN="CENTER">
                    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
                        <TR><TD ALIGN="CENTER"><B><FONT COLOR="#BF360C" POINT-SIZE="9">Step 1</FONT></B></TD></TR>
                        <TR><TD ALIGN="CENTER"><B><FONT COLOR="#E65100" POINT-SIZE="10">Segmentation</FONT></B></TD></TR>
                        <TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#666666">split turn</FONT></TD></TR>
                        <TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#666666">extract context</FONT></TD></TR>
                    </TABLE>
                </TD>
                <TD BGCOLOR="#F3E5F5" COLOR="#6A1B9A" ALIGN="CENTER">
                    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
                        <TR><TD ALIGN="CENTER"><B><FONT COLOR="#6A1B9A" POINT-SIZE="9">Step 2</FONT></B></TD></TR>
                        <TR><TD ALIGN="CENTER"><B><FONT COLOR="#6A1B9A" POINT-SIZE="10">META Filtering</FONT></B></TD></TR>
                        <TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#666666">remove task talk</FONT></TD></TR>
                        <TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#666666">sanity check</FONT></TD></TR>
                    </TABLE>
                </TD>
                <TD BGCOLOR="#E8EAF6" COLOR="#283593" ALIGN="CENTER">
                    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
                        <TR><TD ALIGN="CENTER"><B><FONT COLOR="#283593" POINT-SIZE="9">Step 3</FONT></B></TD></TR>
                        <TR><TD ALIGN="CENTER"><B><FONT COLOR="#283593" POINT-SIZE="10">Classification</FONT></B></TD></TR>
                        <TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#666666">map segments</FONT></TD></TR>
                        <TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#666666">to ontology nodes</FONT></TD></TR>
                    </TABLE>
                </TD>
            </TR>
            <TR>
                <TD BGCOLOR="#FCE4EC" COLOR="#B71C1C" ALIGN="CENTER">
                    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
                        <TR><TD ALIGN="CENTER"><B><FONT COLOR="#B71C1C" POINT-SIZE="9">Step 4</FONT></B></TD></TR>
                        <TR><TD ALIGN="CENTER"><B><FONT COLOR="#B71C1C" POINT-SIZE="10">Triage</FONT></B></TD></TR>
                        <TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#666666">select verdict</FONT></TD></TR>
                        <TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#666666">and primary risk</FONT></TD></TR>
                    </TABLE>
                </TD>
                <TD PORT="constraint" COLSPAN="2" BGCOLOR="#E8F5E9" COLOR="#2E7D32" ALIGN="CENTER">
                    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
                        <TR><TD ALIGN="CENTER"><B><FONT COLOR="#2E7D32" POINT-SIZE="9">Step 5</FONT></B></TD></TR>
                        <TR><TD ALIGN="CENTER"><B><FONT COLOR="#2E7D32" POINT-SIZE="10">Constraint Synthesis</FONT></B></TD></TR>
                        <TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#666666">build validation, clarification, or redirection instruction</FONT></TD></TR>
                    </TABLE>
                </TD>
            </TR>
        </TABLE>>
    ]

    // ── Output ──
    result [
        shape=none margin=0
        label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"
               BGCOLOR="#C8E6C9" COLOR="#2E7D32" STYLE="ROUNDED">
            <TR><TD ALIGN="CENTER"><B><FONT COLOR="#2E7D32" POINT-SIZE="10">SafetyResult</FONT></B></TD></TR>
            <TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7.5" COLOR="#666666">safe / uncertain / unsafe</FONT></TD></TR>
            <TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7.5" COLOR="#666666">constraint for response generator</FONT></TD></TR>
        </TABLE>>
    ]

    // ── Knowledge Graph side annotation ──
    kg [
        shape=none margin=0
        label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"
               BGCOLOR="#FFF8E1" COLOR="#F57F17" STYLE="ROUNDED">
            <TR><TD ALIGN="CENTER"><B><FONT COLOR="#F57F17" POINT-SIZE="9">Safety Ontology</FONT></B></TD></TR>
            <TR><TD ALIGN="CENTER"><FONT POINT-SIZE="7" COLOR="#666666">12 nodes · 15 correction edges</FONT></TD></TR>
        </TABLE>>
    ]

    // ── Main flow ──
    input -> critic [color="#455A64" penwidth=1.4]
    critic -> result [color="#455A64" penwidth=1.4]

    // ── Ontology supports the critic ──
    critic:constraint:e -> kg:w [
        style=dashed color="#F57F17" penwidth=1.0
        dir=back
        label=<  <FONT COLOR="#F57F17" POINT-SIZE="7.5">node metadata + correction edges</FONT>  >
    ]

    // ── Layout hint ──
    {rank=same; input; critic; result}
}
